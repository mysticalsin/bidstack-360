# BidStack 360° — environment variables
# Copy to .env (which is gitignored) and fill in real values.
# All apps load this via dotenv-flow at startup.

# ─── Database ────────────────────────────────────────────────────────────
POSTGRES_USER=bidstack
POSTGRES_PASSWORD=
POSTGRES_DB=bidstack
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}
SHADOW_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}_shadow

# ─── Redis (BullMQ + cache + dedup) ─────────────────────────────────────
# Local Compose publishes Redis on host port 6380. Production must override
# this with a managed non-loopback redis:// or rediss:// URL; API/worker/MCP
# boot validation rejects missing, malformed, or localhost Redis in production.
REDIS_URL=redis://localhost:6380
REDIS_PASSWORD=

# ─── Rate limits + outbound abuse/spend caps ────────────────────────────
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_PER_ORG_MAX=0
# Required in production so rate limits hold across API replicas instead of
# silently degrading to per-process memory counters.
RATE_LIMIT_REDIS_REQUIRED=true
# Reject unbounded Prisma findMany calls by default. Set false only for a
# temporary warn-only migration window with an owner and rollback date.
QUERY_GUARD_REJECT=true
# Daily UTC counters checked before Gmail/Graph/Twilio egress. 0 disables a
# cap. Redis is required in production so caps hold across API replicas.
OUTBOUND_COMM_REDIS_REQUIRED=true
OUTBOUND_EMAIL_DAILY_USER_LIMIT=500
OUTBOUND_EMAIL_DAILY_ORG_LIMIT=50000
OUTBOUND_SMS_DAILY_USER_LIMIT=100
OUTBOUND_SMS_DAILY_ORG_LIMIT=10000
# Money is stored in micros (1 USD = 1,000,000 micros).
OUTBOUND_SMS_DAILY_ORG_COST_CAP_MICROS=500000000
OUTBOUND_SMS_ESTIMATED_SEGMENT_COST_MICROS=8000

# ─── HTTP timeouts ──────────────────────────────────────────────────────
# Inbound request caps protect API workers; provider caps protect outbound
# Gmail/Google, Microsoft Graph, Slack, Twilio, and OAuth calls.
REQUEST_TIMEOUT_MS=30000
KEEPALIVE_TIMEOUT_MS=65000
OAUTH_HTTP_TIMEOUT_MS=15000
GMAIL_HTTP_TIMEOUT_MS=15000
GOOGLE_HTTP_TIMEOUT_MS=15000
MICROSOFT_GRAPH_HTTP_TIMEOUT_MS=15000
SLACK_HTTP_TIMEOUT_MS=10000
TWILIO_HTTP_TIMEOUT_MS=15000
TWILIO_RECORDING_DOWNLOAD_TIMEOUT_MS=45000
# Redis-backed single-flight for OAuth refreshes. Required in production so
# two API replicas cannot refresh the same rotating provider token at once.
OAUTH_REFRESH_LOCK_REDIS_REQUIRED=true
OAUTH_REFRESH_LOCK_TTL_MS=30000
OAUTH_REFRESH_LOCK_WAIT_MS=10000
OAUTH_REFRESH_LOCK_POLL_MS=250

# ─── Auth (Clerk) ───────────────────────────────────────────────────────
# Leave blank in dev — `apps/api` falls back to a stub auth that mints
# a single-user / single-org session. Production REQUIRES real keys.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# ─── Microsoft Entra ID SSO ─────────────────────────────────────────────
# Clerk supports Microsoft OAuth out of the box. Enable "Microsoft" in
# Clerk Dashboard → Authentication → Social Providers. For enterprise
# Entra ID with SAML, use Clerk Dashboard → Organization Settings → SSO.
# These vars are informational — the actual OAuth flow is handled by Clerk.
# Set VITE_SSO_MICROSOFT_ENABLED=true to show the Microsoft login button.
VITE_SSO_MICROSOFT_ENABLED=false
VITE_SSO_MICROSOFT_LABEL="Sign in with Microsoft"
# Optional: restrict Microsoft login to specific tenant domains.
# Comma-separated list, e.g. "mantu.com,client.com"
SSO_ALLOWED_EMAIL_DOMAINS=

# ─── Dust integration ───────────────────────────────────────────────────
# Workspace API
DUST_API_KEY=
DUST_WORKSPACE_ID=mantu-presales
DUST_AGENT_EXEC_BRIEF=
DUST_DATA_SOURCE_ID=ds_bidstack_opportunities
# Webhooks (HMAC validation on /webhooks/dust)
DUST_WEBHOOK_SECRET=
# MCP server public URL (used by Dust to call BidStack tools)
DUST_MCP_PUBLIC_URL=http://localhost:4001
# Optional RFP-specific Dust agents. If unset, the worker uses stable defaults.
DUST_RFP_EXTRACTOR_AGENT_ID=
DUST_RFP_DRAFT_AGENT_ID=
DUST_RFP_COMPLIANCE_AGENT_ID=
DUST_RFP_QA_AGENT_ID=
DUST_RFP_REVIEW_LEGAL_AGENT_ID=
DUST_RFP_REVIEW_FINANCE_AGENT_ID=
DUST_RFP_REVIEW_MARKETING_AGENT_ID=
DUST_RFP_REVIEW_PRESALES_AGENT_ID=
DUST_RFP_REVIEW_BID_AGENT_ID=
DUST_CREW_AGENT_ID=

# ─── Omniparse document intelligence ────────────────────────────────────
# Optional open-source parser/OCR sidecar for richer RFP extraction.
# Documents use /parse_document; images/audio/video use /parse_media/*.
OMNIPARSE_BASE_URL=
OMNIPARSE_TIMEOUT_MS=60000

# ─── Odoo MCP integration ───────────────────────────────────────────────
# Two layers:
#  (1) Sidecar config — passed to the mcp-server-odoo container in
#      docker-compose.yml. The sidecar talks XML-RPC to your Odoo instance.
#  (2) BidStack client config — apps/api uses ODOO_MCP_URL to reach the
#      sidecar over MCP streamable-http. Odoo credentials never enter the
#      BidStack process; they live only inside the sidecar.
#
# Standard mode requires the `mcp-server` Odoo module installed (Odoo 16+).
# Use ODOO_YOLO=true for demos / no-module trials only.
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=
ODOO_USER=
ODOO_PASSWORD=
ODOO_LOCALE=en_US
ODOO_YOLO=false
ODOO_MCP_ENABLE_METHOD_CALLS=false
# Where apps/api looks for the MCP sidecar. Inside docker-compose this is
# `http://mcp-server-odoo:8000/mcp`; on the host it's `http://localhost:8001/mcp`.
ODOO_MCP_URL=
ODOO_MCP_BEARER_TOKEN=
ODOO_MCP_TIMEOUT_MS=15000

# ─── HubSpot OAuth migration connector ─────────────────────────────────
# Create a HubSpot app at https://app.hubspot.com/developer
# Scopes required (minimum): crm.objects.companies.read, crm.objects.contacts.read,
# crm.objects.deals.read, crm.objects.tasks.read
# Redirect URI must match exactly what you register in the HubSpot app settings.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:4000/api/v1/migrations/hubspot/callback

# ─── Integration token encryption ───────────────────────────────────────
# 32-byte key for AES-256-GCM envelope encryption of OAuth tokens at rest.
# Generate: openssl rand -hex 32
# Required for HubSpot OAuth connector (tokens are encrypted in migration_mappings.mappings).
INTEGRATION_TOKEN_KEY=

# ─── Apollo.io company enrichment ───────────────────────────────────────
# Preferred: configure Apollo MCP for account/company search and get-company.
# BidStack stores firmographics, technologies, intent/news signals, and sync
# freshness only. Emails and phone numbers are stripped and not persisted.
# Enable credit-sensitive tools only if you accept your Apollo plan usage.
APOLLO_MCP_URL=https://mcp.apollo.io/mcp
APOLLO_MCP_BEARER_TOKEN=
APOLLO_MCP_TIMEOUT_MS=10000
APOLLO_MCP_SEARCH_COMPANIES_TOOL=search_companies
APOLLO_MCP_GET_COMPANY_TOOL=get_company
APOLLO_MCP_SEARCH_PEOPLE_TOOL=search_people
APOLLO_MCP_GET_JOB_POSTINGS_TOOL=get_job_postings
APOLLO_MCP_ENABLE_EXECUTIVE_SEARCH=false
APOLLO_MCP_ENABLE_CREDIT_TOOLS=false
# Fallback: when MCP is not configured, the worker can call Apollo REST
# organization enrichment. Current Apollo docs mark this as credit-using.
# REST People Search is explicit opt-in only for title-level C-suite movement.
# BidStack never calls Apollo People Enrichment for account intelligence.
APOLLO_API_KEY=
APOLLO_API_ENABLE_PEOPLE_SEARCH=false
APOLLO_API_PEOPLE_SEARCH_PER_PAGE=10
# Public news cross-check validates funding, hiring, layoffs, expansion, and
# leadership movement against recent coverage. Disable only if your deployment
# blocks outbound public-news lookups.
APOLLO_NEWS_CROSSCHECK_ENABLED=true

# ─── RFP LLM provider (proposal drafting, review crews, QA, evals) ────────
# Select one: dust (default/no direct provider), openai, anthropic, moonshot,
# kimi, nim, nvidia-nim, gemma. Secrets belong in .env / secret manager only.
RFP_LLM_PROVIDER=
RFP_LLM_TIMEOUT_MS=120000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_BASE_URL=https://api.anthropic.com
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-32k
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_ALLOW_CUSTOM_BASE_URL=false
NVIDIA_NIM_THINKING=false
GEMMA_API_KEY=
GEMMA_MODEL=gemma3
GEMMA_BASE_URL=http://localhost:11434/v1

# ─── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT_API=4000
PORT_MCP=4001
PORT_WEB=5173
PUBLIC_API_URL=http://localhost:4000
PUBLIC_BASE_URL=http://localhost:5173
TRUSTED_PROXIES=
# Disabled by default. Enable only for admin-protected API reference builds or
# internal docs generation; the OpenAPI routes expose operational route shape.
OPENAPI_DOCS_ENABLED=false

# ─── HTML to PDF renderer ───────────────────────────────────────────────
# API Docker images set this to /usr/bin/chromium-browser. Local dev can
# leave it blank; signed-document rendering falls back to pdf-lib if Chrome
# is unavailable, and increments the pdf_render_fallback_total metric.
PUPPETEER_EXECUTABLE_PATH=
CHROME_BIN=

# ─── Durable file storage (required in production) ───────────────────────
# Production rejects local disk storage. Current implementation supports
# STORAGE_DRIVER=s3. For Azure, either provide an S3-compatible endpoint
# (MinIO/R2/etc.) or add a native Azure Blob adapter before using Blob directly.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_UPLOAD_MAX_BYTES=52428800
STORAGE_SCAN_REQUIRED=false

# ─── Observability (optional in dev) ────────────────────────────────────
# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=bidstack-api

# ─── Vite (frontend public env — VITE_* prefix required) ────────────────
VITE_API_URL=http://localhost:4000
VITE_CLERK_PUBLISHABLE_KEY=
VITE_DUST_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# ─── Notifications ───────────────────────────────────────────────────────
# Email (Resend) — leave blank to disable email notifications in dev
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=BidStack <notifications@bidstack.app>

# Web Push (VAPID) — generate keys with: npx web-push generate-vapid-keys
# Leave blank to disable web push in dev
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@bidstack.app

# Frontend: expose VAPID public key so the browser can subscribe
VITE_VAPID_PUBLIC_KEY=

# ─── Microsoft Graph Mail (Outlook integration) ──────────────────────────
# Azure portal setup: https://portal.azure.com → App registrations
# 1. New registration → set redirect URI to MICROSOFT_GRAPH_MAIL_REDIRECT_URI
# 2. API permissions → Add: Mail.Send, Mail.Read, offline_access (delegated)
#    Optional for near-real-time: Mail.ReadWrite (needed for webhooks on /me/messages)
# 3. Certificates & secrets → New client secret → copy to MICROSOFT_GRAPH_CLIENT_SECRET
# 4. Grant admin consent for delegated permissions
#
# For multi-tenant apps leave MICROSOFT_TENANT_ID=common.
# For single-tenant orgs set MICROSOFT_TENANT_ID to the Entra tenant GUID.
#
# MICROSOFT_WEBHOOK_BASE_URL: public HTTPS URL where Graph posts notifications.
# Graph rejects http:// or self-signed certs. Use ngrok/cloudflare tunnel in dev.
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_GRAPH_MAIL_REDIRECT_URI=http://localhost:4000/api/v1/integrations/microsoft/mail/oauth/callback
MICROSOFT_WEBHOOK_BASE_URL=https://your-domain.com

# Gmail OAuth 2.0 (Wave 5 — full Gmail integration)
# Google Cloud Console: APIs & Services → Credentials → OAuth 2.0 Client ID
# Scopes requested:
#   https://www.googleapis.com/auth/gmail.send     — send on behalf of user
#   https://www.googleapis.com/auth/gmail.readonly — incremental pull / history
#   WHY not gmail.modify: send+readonly is least-privilege for send-log-pull.
#     gmail.modify (restricted) needed only if you want to archive/label server-side.
# Authorized redirect URI must match GMAIL_REDIRECT_URI exactly.
# Add http://localhost:4000/... for dev; your production URL for prod.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/v1/integrations/gmail/oauth/callback

# Aliases — GOOGLE_OAUTH_CLIENT_ID / _SECRET map to same credentials as GMAIL_.
# Use these if you register a single OAuth 2.0 app for all Google APIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/gmail/oauth/callback

# ─── PII Field Encryption (Wave 5) ──────────────────────────────────────
# AES-256-GCM encryption for Contact/Lead/KAM PII fields (email, phone).
#
# ACTIVATION STEPS:
#   1. Generate key: openssl rand -hex 32
#   2. Store in secret manager; set PII_ENCRYPTION_MASTER_KEY below.
#   3. Run migration: tsx scripts/encrypt-existing-pii.ts
#   4. Flip PII_FIELD_ENCRYPTION=true and redeploy.
#   Rollback: tsx scripts/decrypt-pii-rollback.ts
#   Full runbook: docs/security/pii-field-encryption.md
#
# Default is FALSE for backward compatibility with existing plaintext data.
PII_ENCRYPTION_MASTER_KEY=
PII_FIELD_ENCRYPTION=false
# Release-evidence controls for PII storage at rest. `User.email` is not
# field-encrypted until a generated User.emailHash migration exists; production
# release evidence must either set these to real storage-encryption proof and
# `storage-encryption-only`, or the gate fails.
# Current release also has known plaintext-at-field-level PII surfaces outside
# the field-encryption map: SmsMessage body/numbers, SmsConsent.phoneNumber,
# ActivityAttendee.email, CalendarEvent.attendees, and KamSession transcript /
# attendees. Production release evidence must explicitly accept this exact
# scope as storage-encryption-only, or implement field encryption first.
BIDSTACK_STORAGE_ENCRYPTION_AT_REST=false
BIDSTACK_STORAGE_ENCRYPTION_PROVIDER=
BIDSTACK_STORAGE_ENCRYPTION_EVIDENCE=
BIDSTACK_USER_EMAIL_AT_REST_DECISION=
BIDSTACK_USER_EMAIL_AT_REST_DECISION_REF=
BIDSTACK_USER_EMAIL_AT_REST_DECISION_OWNER=
BIDSTACK_PLAINTEXT_PII_AT_REST_DECISION=
BIDSTACK_PLAINTEXT_PII_AT_REST_DECISION_REF=
BIDSTACK_PLAINTEXT_PII_AT_REST_DECISION_OWNER=
BIDSTACK_PLAINTEXT_PII_AT_REST_ACCEPTED_FIELDS=

# Tenant-scope guard for broad Prisma operations on models with orgId.
# off = disabled; warn = emit warnings; enforce = throw before unscoped
# findMany/count/aggregate/groupBy/updateMany/deleteMany can run.
# Roll out with warn first, then enforce after intentional maintenance scans
# are wrapped or rewritten. REQUIRED in production: apps/api/src/env.ts,
# apps/worker/src/lib/production-env.ts, and apps/mcp-server/src/production-env.ts
# all fail boot unless this is 'warn' or 'enforce' ('enforce' recommended).
BIDSTACK_TENANT_SCOPE_GUARD=off

# ─── Wave 7 — Read-replica routing ──────────────────────────────────────────
# If omitted, reads fall back to DATABASE_URL (single-node mode).
# Point to a PgBouncer pooler or Postgres read-replica.
DATABASE_URL_REPLICA=

# How many seconds of replica lag is acceptable before routing reads to primary.
# Default: 5 seconds. Increase for analytics-only workloads; decrease for
# strict read-after-write consistency requirements.
MAX_REPLICA_LAG_SECONDS=5

# ─── Wave 7 — Backup automation ──────────────────────────────────────────────
# S3-compatible object storage for pg_dump backups. Required for production
# backup automation; leaving BACKUP_S3_BUCKET blank disables S3 upload.
# IAM minimal privilege: s3:PutObject + s3:GetObject + s3:DeleteObject on
# $BACKUP_S3_BUCKET/$BACKUP_S3_PREFIX/* and s3:ListBucket on $BACKUP_S3_BUCKET.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=bidstack/prod
BACKUP_S3_REGION=eu-west-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET=

# Backup parallelism (pg_dump --jobs). Set to number of CPU cores available.
BACKUP_PARALLELISM=4

# Optional locally, required for production-grade backup evidence: GPG symmetric
# passphrase for backup encryption at rest. Store in a secret manager, not git.
# Generate: openssl rand -hex 32
# If set, backups are encrypted before S3 upload (.dump.gpg extension).
BACKUP_ENCRYPT_KEY=

# Slack webhook for recovery drill failure notifications.
DRILL_SLACK_WEBHOOK=

# ─── Wave 8 — Voice + Video Calls ────────────────────────────────────────────
#
# ZOOM (Server-to-Server OAuth app)
# Register at: https://marketplace.zoom.us/develop/create → App type: Server-to-Server OAuth
# Scopes required: meeting:write:admin, meeting:read:admin, recording:read:admin
# Enable "Event Subscriptions" → add webhook URL: $PUBLIC_API_URL/api/v1/integrations/zoom/webhook
# Subscribe to: meeting.ended, recording.completed, meeting.started
# Copy "Account ID", "Client ID", "Client Secret" below.
# ZOOM_SECRET_TOKEN: Zoom webhook validation token (Event Subscriptions → Secret Token).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SECRET_TOKEN=

# MICROSOFT TEAMS (uses existing Microsoft Graph app — add scopes below)
# In the Azure portal app (MICROSOFT_GRAPH_CLIENT_ID above), add delegated scopes:
#   OnlineMeetings.ReadWrite, OnlineMeetingRecording.Read.All
# No separate client credentials needed — reuses MICROSOFT_GRAPH_CLIENT_* above.

# GOOGLE MEET (uses existing Google OAuth app — add scopes below)
# In Google Cloud Console (GMAIL_CLIENT_ID above), enable:
#   Google Calendar API (for conferenceData creation)
#   Add scope: https://www.googleapis.com/auth/calendar.events
# No separate client credentials needed — reuses GMAIL_CLIENT_* above.

# TWILIO VOICE
# Twilio Console: Phone Numbers → Buy a number (enable Voice capability)
# TwiML App: Voice → TwiML Apps → Create → set Voice Request URL to
#   $PUBLIC_API_URL/api/v1/integrations/twilio-voice/webhook
# Copy Account SID and Auth Token from Console Dashboard.
# TWILIO_VOICE_PHONE_NUMBER: E.164 Twilio number for outbound dial (e.g. +15551234567)
# NOTE: TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN may already be set for SMS.
#       If so, skip — voice uses the same credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_PHONE_NUMBER=

# TRANSCRIPTION — Deepgram (chosen over Whisper for real-time diarization)
# Register at https://console.deepgram.com → Create API key
# WHY Deepgram over OpenAI Whisper:
#   - Native speaker diarization (word-level) without post-processing
#   - Streaming transcription (low latency for live calls)
#   - Better accuracy on accented English/French (Mantu global teams)
DEEPGRAM_API_KEY=

# S3-compatible storage for call recordings (reuses backup bucket credentials or separate bucket)
# Grant: s3:PutObject, s3:GetObject on $CALL_RECORDINGS_S3_BUCKET/recordings/*
# Set to the same BACKUP_S3_* values or a dedicated recordings bucket.
CALL_RECORDINGS_S3_BUCKET=
CALL_RECORDINGS_S3_PREFIX=recordings
CALL_RECORDINGS_S3_REGION=eu-west-1
CALL_RECORDINGS_S3_ACCESS_KEY=
CALL_RECORDINGS_S3_SECRET=
# Signed URL TTL in seconds (default: 300 = 5 min). Short expiry limits PII exposure.
CALL_RECORDINGS_SIGNED_URL_TTL_SEC=300

# ─── Wave 8 — Multi-currency + Tax + Forecast + Commission ───────────────────

# ECB reference rate fetch (daily cron at 04:00 UTC)
# Default points to the ECB daily XML feed (EUR base, ~32 currency pairs).
# Override with a mock URL in CI or set MANUAL rates via POST /exchange-rates.
ECB_RATES_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml

# ─── Demo-feedback program — feature flags + integrations (2026-06-12) ────────
# Flags are served to the SPA via GET /api/v1/config/features; flipping one is
# an API restart, not a web rebuild. Default false = the dependent block is
# HIDDEN entirely (never an empty state).

# Win/Loss block on the account view. Derived from the account's own BidStack
# opportunity pipeline (won/lost stages) — real today. Default on; set false to
# hide. A richer Opportunity-Management feed can replace the source later
# without changing the wire contract.
WIN_LOSS_DATA_AVAILABLE=true

# Revenue-evolution block — won-deal value by close month from the account's
# own pipeline. Real today; default on. Swap to an ABC revenue feed later.
SHOW_REVENUE_BLOCK=true

# InfoSearch lead-intel MCP integration (call lists surfaced on account pages;
# account views are reported back to InfoSearch as activity events).
INFOSEARCH_ENABLED=false
INFOSEARCH_MCP_URL=
INFOSEARCH_API_KEY=

# 360Learning / Mantu Academy LMS (Sales Toolkits section; live fetch only,
# nothing stored). NOTE: the spec called these 360L_* but env identifiers
# cannot start with a digit — hence the LMS_ prefix.
LMS_360L_ENABLED=false
LMS_360L_BASE_URL=https://mantuacademy.360learning.com
LMS_360L_API_KEY=

# SERUM control plane. Defaults off: no autonomous loop, memory, or pattern
# learning surface should look live until the backend controls are configured.
SERUM_ENABLED=false
SERUM_DEMO_MODE_ENABLED=false

# ════════════════════════════════════════════════════════════════════════════
# Deployment contract — keys read by code but previously undocumented here.
# Audited 2026-06-13 (Baton finding #10): source referenced ~80 env vars absent
# from this file. Grouped below; blank = optional unless the comment says
# REQUIRED. Prisma engine internals + test-only toggles are intentionally omitted.
# ════════════════════════════════════════════════════════════════════════════

# --- Core secrets (REQUIRED in production) ---
# APP_SECRET derives the AES-256-GCM key for Yjs/PII field encryption — set a
# 64-hex-char value in prod (PII_FIELD_ENCRYPTION=true relies on it).
APP_SECRET=
# Signs BullMQ job payloads so a worker rejects forged jobs (either name works;
# BIDSTACK_JOB_SIGNING_SECRET takes precedence when both are set).
JOB_SIGNING_SECRET=
BIDSTACK_JOB_SIGNING_SECRET=
# Bearer token protecting GET /metrics. UNSET => the route returns 404 (metrics
# disabled). Set it in prod so Prometheus can scrape with Authorization.
METRICS_BEARER_TOKEN=
# Signs NPS survey + demo-session tokens.
NPS_TOKEN_SECRET=
DEMO_SESSION_SECRET=

# --- Public URLs ---
API_URL=http://localhost:8787
APP_BASE_URL=http://localhost:5173
ASSET_CDN_URL=

# --- File storage ---
# StorageAdapter: local (default) writes under LOCAL_STORAGE_ROOT; s3 uses AWS_REGION.
LOCAL_STORAGE_ROOT=./.storage
AWS_REGION=

# --- OCR + document extraction (off by default) ---
# Enable real OCR for scanned MSAs/contracts. Needs tesseract + ocrmypdf on the
# host (born-digital PDFs parse without it). See the contract-extraction lane.
BIDSTACK_OCR_ENABLED=false
BIDSTACK_OCR_LANGUAGES=eng+fra
BIDSTACK_OCR_TIMEOUT_MS=120000
BIDSTACK_TESSERACT_BIN=tesseract
BIDSTACK_OCRMYPDF_BIN=ocrmypdf

# --- Other platform toggles ---
# Allow the dev auth stub instead of Clerk (NEVER true in production).
BIDSTACK_ALLOW_STUB_AUTH=false
# Production REST API keys must use exact permission scopes such as
# opportunities:read. Dev/test allow legacy broad read/write by default; set
# this true only for a time-boxed migration of existing REST keys.
BIDSTACK_ALLOW_LEGACY_API_KEY_SCOPES=false
# Disable the keyless open-enrichment fallback.
BIDSTACK_OPEN_ENRICHMENT_DISABLED=false
# User-agent sent on outbound enrichment/competitor HTTP calls.
BIDSTACK_USER_AGENT=BidStack360/1.0

# --- Salesforce integration (OAuth) ---
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_REDIRECT_URI=

# --- Microsoft / Graph integration (OAuth; TENANT_ID declared above) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# --- Slack integration ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
# REQUIRED for Slack webhooks — slack.helpers throws at runtime if unset.
SLACK_SIGNING_SECRET=

# --- DocuSign e-signature ---
DOCUSIGN_BASE_URL=https://demo.docusign.net
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
# JWT private key (PEM). Keep out of source control.
DOCUSIGN_PRIVATE_KEY=

# --- ERP MCP connector ---
# Off by default: v0.1 ships ONE global ERP connection shared by every org in
# this deployment (see apps/api/src/routes/erp-integration.ts header). Flip on
# only for a single-tenant deployment, or once per-org ERP connections ship.
ERP_ENABLED=false
ERP_MCP_URL=
ERP_MCP_BEARER_TOKEN=
ERP_MCP_TIMEOUT_MS=15000
ERP_DB=

# --- Dust agent IDs (per capability; blank => that AI step falls back) ---
DUST_AGENT_ACCOUNT_INTEL=
DUST_AGENT_EMAIL_DRAFT=
DUST_AGENT_ENRICH=
DUST_AGENT_MEETING_PREP=
DUST_AGENT_SENTIMENT=
DUST_COMPETITOR_AGENT_ID=
DUST_DOCUMENT_EXTRACT_AGENT_ID=

# --- Competitor research ---
COMPETITOR_SEARCH_PROVIDER=
COMPETITOR_SEARCH_API_KEY=
COMPETITOR_RESEARCH_UA=BidStack360/1.0
# SEC EDGAR requires a descriptive UA with contact info per their fair-use policy.
SEC_USER_AGENT=

# --- Extra LLM / eval ---
COHERE_API_KEY=
EVAL_MODE=false
EVAL_LLM_PROVIDER=

# --- Predictive lead scoring (optional XGBoost path) ---
PREDICTIVE_USE_XGBOOST=false
PREDICTIVE_PYTHON_BIN=python
PREDICTIVE_XGBOOST_SCRIPT=
PREDICTIVE_XGBOOST_TIMEOUT_MS=30000

# --- Release identity exposed by API/MCP health surfaces ---
# Set these on deployed API/MCP services from the immutable release build. The
# strict release-evidence gate compares live health/discovery responses against
# source-control evidence so stale deployments cannot pass connectivity proof.
BIDSTACK_RELEASE_COMMIT=
BIDSTACK_RELEASE_BRANCH=

# --- Observability (Datadog / Sentry / OpenTelemetry) ---
DD_API_KEY=
DD_ENV=
DD_SERVICE=bidstack-api
DD_VERSION=
DD_PROFILING_ENABLED=false
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Controlled release-only smoke triggers. Disabled unless explicitly armed.
SENTRY_SMOKE_ENABLED=false
SENTRY_SMOKE_TOKEN=
# Release-evidence Sentry smoke controls. These are used by
# `pnpm deploy:evidence:sentry:trigger` / release bundle, not normal runtime.
BIDSTACK_SENTRY_EVIDENCE_PATH=deploy-evidence/sentry-smoke-latest.json
BIDSTACK_SENTRY_API_BASE_URL=
BIDSTACK_SENTRY_SMOKE_TOKEN=
BIDSTACK_SENTRY_AUTH_TOKEN=
BIDSTACK_SENTRY_RELEASE=
BIDSTACK_SENTRY_ORG=
BIDSTACK_SENTRY_API_PROJECT=
BIDSTACK_SENTRY_WORKER_PROJECT=
BIDSTACK_SENTRY_DSN_CONFIGURED=false

# --- CI repeat release evidence ---
# Release gate input only. Provide compact CI metadata for at least 10
# consecutive full-suite runs tied to the exact release commit/branch. Do not
# include raw logs, command output, secret values, or raw provider payloads.
BIDSTACK_CI_REPEAT_EVIDENCE=deploy-evidence/ci-repeat-latest.json
BIDSTACK_CI_REPEAT_INPUT=
BIDSTACK_CI_REPEAT_RUNS_JSON=
BIDSTACK_CI_REQUIRED_RUN_COUNT=10
BIDSTACK_CI_REQUIRED_CHECKS=install,audit,db:generate,lint,typecheck,test,build
BIDSTACK_CI_PROVIDER=
BIDSTACK_CI_REPOSITORY=
BIDSTACK_CI_WORKFLOW=
BIDSTACK_CI_RELEASE_COMMIT=
BIDSTACK_CI_BRANCH=

OTEL_SERVICE_VERSION=

# --- Monitoring thresholds (worker alerting) ---
MONITOR_QUEUE_DEPTH_WARN=1000
MONITOR_QUEUE_DEPTH_CRIT=5000
MONITOR_EMBED_FAIL_RATE=0.25

# --- Health-check ports ---
WORKER_HEALTH_PORT=8788
MCP_HEALTH_PORT=8789

# --- Yjs collaborative-editing maintenance ---
YJS_COMPACT_CRON=0 */6 * * *
YJS_PRUNE_DAYS=30

# --- Demo mode (ephemeral multi-org demo instance) ---
DEMO_MODE=false
# Required as a second operator acknowledgement before DEMO_MODE=true can run in
# production. This is only for intentionally public demo deployments, never a
# real enterprise tenant.
DEMO_PUBLIC_DEPLOYMENT_ACK=false
DEMO_AUTO_ENRICH=false
DEMO_MAX_ORGS=50
DEMO_ORG_TTL_HOURS=24

# --- Production compose host ports ---
WEB_HTTP_PORT=8080

# --- Misc ---
GOOGLE_CALENDAR_WEBHOOK_URL=
OPENAPI_SPEC_FILE=
PUBLIC_BOOKING_RATE_LIMIT_MAX=20

# --- Error monitoring (Sentry — already wired in web/api/worker; opt-in) ---
# Free options, no paid key needed: Sentry's free tier gives a DSN (a public
# ingest URL, not a secret), or self-host GlitchTip (Sentry-compatible, FOSS) and
# use its DSN. Unset = monitoring is a silent no-op.
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Session replay is privacy-sensitive (masks inputs); enable only with sign-off.
VITE_SENTRY_REPLAY=false

# --- Seamless.AI enrichment (paid EXTERNAL source; preferred over the free
# Wikidata path when set). MCP is preferred for the Technical Stack source-pull
# lane; REST API remains the fallback. Never commit a real token. Unset => the
# keyless open enrichment is used. ---
SEAMLESS_MCP_URL=
SEAMLESS_MCP_BEARER_TOKEN=
SEAMLESS_MCP_TIMEOUT_MS=15000
SEAMLESS_MCP_SEARCH_COMPANIES_TOOL=search_companies
SEAMLESS_API_KEY=
SEAMLESS_API_BASE_URL=https://api.seamless.ai/api/client/v1

# --- Optional generic Technical Stack MCP source ---
# Use this for a configured BuiltWith/Wappalyzer/private tech-intel MCP gateway.
# Unset => lane is visible as not configured and no fake provider data is shown.
TECH_STACK_MCP_URL=
TECH_STACK_MCP_BEARER_TOKEN=
TECH_STACK_MCP_TIMEOUT_MS=12000
TECH_STACK_MCP_TOOL=detect_company_technologies
TECH_STACK_MCP_LABEL=Tech Intel MCP
# Optional named Tech Intel MCP sources. Add ids here, then define
# TECH_STACK_MCP_<ID>_URL and optional _BEARER_TOKEN/_TOOL/_LABEL/_TIMEOUT_MS.
# Example: TECH_STACK_MCP_SOURCE_IDS=BUILTWITH,WAPPALYZER
TECH_STACK_MCP_SOURCE_IDS=
TECH_STACK_MCP_BUILTWITH_URL=
TECH_STACK_MCP_BUILTWITH_BEARER_TOKEN=
TECH_STACK_MCP_BUILTWITH_TOOL=detect_company_technologies
TECH_STACK_MCP_BUILTWITH_LABEL=BuiltWith MCP
TECH_STACK_MCP_WAPPALYZER_URL=
TECH_STACK_MCP_WAPPALYZER_BEARER_TOKEN=
TECH_STACK_MCP_WAPPALYZER_TOOL=detect_company_technologies
TECH_STACK_MCP_WAPPALYZER_LABEL=Wappalyzer MCP
