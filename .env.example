# BidStack 360° — environment variables
# Copy to .env (which is gitignored) and fill in real values.
# All apps load this via dotenv-flow at startup.

# ─── Database ────────────────────────────────────────────────────────────
POSTGRES_USER=bidstack
POSTGRES_PASSWORD=
POSTGRES_DB=bidstack
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}
SHADOW_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}_shadow

# ─── Redis (BullMQ + cache + dedup) ─────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── Auth (Clerk) ───────────────────────────────────────────────────────
# Leave blank in dev — `apps/api` falls back to a stub auth that mints
# a single-user / single-org session. Production REQUIRES real keys.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# ─── Microsoft Entra ID SSO ─────────────────────────────────────────────
# Clerk supports Microsoft OAuth out of the box. Enable "Microsoft" in
# Clerk Dashboard → Authentication → Social Providers. For enterprise
# Entra ID with SAML, use Clerk Dashboard → Organization Settings → SSO.
# These vars are informational — the actual OAuth flow is handled by Clerk.
# Set VITE_SSO_MICROSOFT_ENABLED=true to show the Microsoft login button.
VITE_SSO_MICROSOFT_ENABLED=false
VITE_SSO_MICROSOFT_LABEL="Sign in with Microsoft"
# Optional: restrict Microsoft login to specific tenant domains.
# Comma-separated list, e.g. "mantu.com,client.com"
SSO_ALLOWED_EMAIL_DOMAINS=

# ─── Dust integration ───────────────────────────────────────────────────
# Workspace API
DUST_API_KEY=
DUST_WORKSPACE_ID=mantu-presales
DUST_AGENT_EXEC_BRIEF=
DUST_DATA_SOURCE_ID=ds_bidstack_opportunities
# Webhooks (HMAC validation on /webhooks/dust)
DUST_WEBHOOK_SECRET=
# MCP server public URL (used by Dust to call BidStack tools)
DUST_MCP_PUBLIC_URL=http://localhost:4001

# ─── Odoo MCP integration ───────────────────────────────────────────────
# Two layers:
#  (1) Sidecar config — passed to the mcp-server-odoo container in
#      docker-compose.yml. The sidecar talks XML-RPC to your Odoo instance.
#  (2) BidStack client config — apps/api uses ODOO_MCP_URL to reach the
#      sidecar over MCP streamable-http. Odoo credentials never enter the
#      BidStack process; they live only inside the sidecar.
#
# Standard mode requires the `mcp-server` Odoo module installed (Odoo 16+).
# Use ODOO_YOLO=true for demos / no-module trials only.
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=
ODOO_USER=
ODOO_PASSWORD=
ODOO_LOCALE=en_US
ODOO_YOLO=false
ODOO_MCP_ENABLE_METHOD_CALLS=false
# Where apps/api looks for the MCP sidecar. Inside docker-compose this is
# `http://mcp-server-odoo:8000/mcp`; on the host it's `http://localhost:8001/mcp`.
ODOO_MCP_URL=
ODOO_MCP_BEARER_TOKEN=
ODOO_MCP_TIMEOUT_MS=15000

# ─── HubSpot OAuth migration connector ─────────────────────────────────
# Create a HubSpot app at https://app.hubspot.com/developer
# Scopes required (minimum): crm.objects.companies.read, crm.objects.contacts.read,
# crm.objects.deals.read, crm.objects.tasks.read
# Redirect URI must match exactly what you register in the HubSpot app settings.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:4000/api/v1/migrations/hubspot/callback

# ─── Integration token encryption ───────────────────────────────────────
# 32-byte key for AES-256-GCM envelope encryption of OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required for HubSpot OAuth connector (tokens are encrypted in migration_mappings.mappings).
INTEGRATION_TOKEN_KEY=

# ─── Apollo.io company enrichment ───────────────────────────────────────
# When set, the company-enrich-apollo BullMQ worker calls
# https://api.apollo.io/v1/organizations/enrich and writes to CompanyEnrichment.
# Free tier: 50 credits/month. Unset → worker no-ops with a warn.
APOLLO_API_KEY=

# ─── LLM fallback (proposal drafting + exec briefs when Dust agent down) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ─── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT_API=4000
PORT_MCP=4001
PORT_WEB=5173
PUBLIC_API_URL=http://localhost:4000
PUBLIC_BASE_URL=http://localhost:5173
TRUSTED_PROXIES=

# ─── Observability (optional in dev) ────────────────────────────────────
# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=bidstack-api

# ─── Vite (frontend public env — VITE_* prefix required) ────────────────
VITE_API_URL=http://localhost:4000
VITE_CLERK_PUBLISHABLE_KEY=
VITE_DUST_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# ─── Notifications ───────────────────────────────────────────────────────
# Email (Resend) — leave blank to disable email notifications in dev
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=BidStack <notifications@bidstack.app>

# Web Push (VAPID) — generate keys with: npx web-push generate-vapid-keys
# Leave blank to disable web push in dev
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@bidstack.app

# Frontend: expose VAPID public key so the browser can subscribe
VITE_VAPID_PUBLIC_KEY=

# ─── Microsoft Graph Mail (Outlook integration) ──────────────────────────
# Azure portal setup: https://portal.azure.com → App registrations
# 1. New registration → set redirect URI to MICROSOFT_GRAPH_MAIL_REDIRECT_URI
# 2. API permissions → Add: Mail.Send, Mail.Read, offline_access (delegated)
#    Optional for near-real-time: Mail.ReadWrite (needed for webhooks on /me/messages)
# 3. Certificates & secrets → New client secret → copy to MICROSOFT_GRAPH_CLIENT_SECRET
# 4. Grant admin consent for delegated permissions
#
# For multi-tenant apps leave MICROSOFT_TENANT_ID=common.
# For single-tenant orgs set MICROSOFT_TENANT_ID to the Entra tenant GUID.
#
# MICROSOFT_WEBHOOK_BASE_URL: public HTTPS URL where Graph posts notifications.
# Graph rejects http:// or self-signed certs. Use ngrok/cloudflare tunnel in dev.
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_GRAPH_MAIL_REDIRECT_URI=http://localhost:4000/api/v1/integrations/microsoft/mail/oauth/callback
MICROSOFT_WEBHOOK_BASE_URL=https://your-domain.com

# Gmail OAuth 2.0 (Wave 5 — paired integration)
# Google Cloud Console: APIs & Services → Credentials → OAuth 2.0 Client ID
# Scopes: gmail.send, gmail.readonly. Add redirect URI below.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/v1/integrations/gmail/oauth/callback
