{
  "name": "bidstack-360",
  "version": "0.1.0",
  "private": true,
  "description": "BidStack 360° — Mantu's bid & presales CRM. Standalone build with future Twenty overlay path preserved under packages/twenty-bidstack.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0 <11"
  },
  "packageManager": "pnpm@10.27.0",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --quiet --no-warn-ignored"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:web": "pnpm --filter @bidstack/web dev",
    "dev:api": "pnpm --filter @bidstack/api dev",
    "dev:worker": "pnpm --filter @bidstack/worker dev",
    "dev:mcp": "pnpm --filter @bidstack/mcp-server dev",
    "preview": "pnpm --filter @bidstack/web preview",
    "build": "pnpm -r --stream build",
    "lint": "pnpm -r --stream lint",
    "typecheck": "pnpm db:generate && pnpm --filter @bidstack/shared build && pnpm --filter @bidstack/dust-client build && pnpm --filter @bidstack/odoo-mcp-client build && pnpm -r --stream typecheck",
    "test": "pnpm test:hermeticity && pnpm --filter @bidstack/shared build && pnpm --filter @bidstack/db build && pnpm --filter @bidstack/dust-client build && pnpm --filter @bidstack/odoo-mcp-client build && node scripts/run-worker-tests.mjs && pnpm -r --filter \"!@bidstack/worker\" --workspace-concurrency=1 --stream test",
    "test:hermeticity": "node scripts/verify-test-hermeticity.mjs",
    "test:hermeticity:selftest": "node scripts/verify-test-hermeticity.mjs --selftest",
    "test:watch": "pnpm -r --parallel --stream test:watch",
    "e2e": "pnpm --filter @bidstack/web e2e",
    "load-test": "node scripts/run-k6-load-test.mjs",
    "load-test:certify": "cross-env K6_DURATION_PROFILE=certification node scripts/run-k6-load-test.mjs",
    "load-test:selftest": "node scripts/run-k6-load-test.mjs --selftest",
    "load-test:rfp": "tsx scripts/load-test-rfp.ts",
    "container:scan": "node scripts/run-container-vulnerability-scan.mjs",
    "security:scan": "node scripts/run-semgrep-sast.mjs",
    "deploy:evidence": "node scripts/verify-deploy-evidence.mjs",
    "deploy:evidence:staging": "cross-env BIDSTACK_DEPLOY_ENV=staging node scripts/verify-deploy-evidence.mjs",
    "deploy:evidence:production": "cross-env BIDSTACK_DEPLOY_ENV=production node scripts/verify-deploy-evidence.mjs",
    "deploy:evidence:selftest": "node scripts/verify-deploy-evidence.mjs --selftest",
    "deploy:evidence:bundle": "node scripts/run-deploy-evidence-bundle.mjs",
    "deploy:evidence:bundle:staging": "cross-env BIDSTACK_DEPLOY_ENV=staging node scripts/run-deploy-evidence-bundle.mjs",
    "deploy:evidence:bundle:production": "cross-env BIDSTACK_DEPLOY_ENV=production node scripts/run-deploy-evidence-bundle.mjs",
    "deploy:evidence:bundle:selftest": "node scripts/run-deploy-evidence-bundle.mjs --selftest",
    "deploy:evidence:preflight": "node scripts/run-deploy-evidence-bundle.mjs --preflight-only --out deploy-evidence/release-preflight-latest.json",
    "deploy:evidence:preflight:staging": "cross-env BIDSTACK_DEPLOY_ENV=staging node scripts/run-deploy-evidence-bundle.mjs --preflight-only --out deploy-evidence/release-preflight-latest.json",
    "deploy:evidence:preflight:production": "cross-env BIDSTACK_DEPLOY_ENV=production node scripts/run-deploy-evidence-bundle.mjs --preflight-only --out deploy-evidence/release-preflight-latest.json",
    "deploy:evidence:source": "node scripts/write-source-control-evidence.mjs",
    "deploy:evidence:source:selftest": "node scripts/write-source-control-evidence.mjs --selftest",
    "deploy:evidence:source:plan": "node scripts/write-source-review-plan.mjs",
    "deploy:evidence:source:plan:write": "node scripts/write-source-review-plan.mjs --allow-active",
    "deploy:evidence:source:plan:selftest": "node scripts/write-source-review-plan.mjs --selftest",
    "deploy:evidence:ci": "node scripts/write-ci-repeat-evidence.mjs",
    "deploy:evidence:ci:selftest": "node scripts/write-ci-repeat-evidence.mjs --selftest",
    "deploy:evidence:ops": "node scripts/write-operational-readiness-evidence.mjs",
    "deploy:evidence:ops:selftest": "node scripts/write-operational-readiness-evidence.mjs --selftest",
    "deploy:evidence:compose:policy": "node scripts/verify-compose-production-policy.mjs",
    "deploy:evidence:compose:policy:selftest": "node scripts/verify-compose-production-policy.mjs --selftest",
    "deploy:evidence:azure:policy": "node scripts/verify-azure-infra-policy.mjs",
    "deploy:evidence:azure:policy:selftest": "node scripts/verify-azure-infra-policy.mjs --selftest",
    "deploy:evidence:secret-rotation:policy": "node scripts/verify-secret-rotation-policy.mjs",
    "deploy:evidence:secret-rotation:policy:selftest": "node scripts/verify-secret-rotation-policy.mjs --selftest",
    "deploy:evidence:secret-rotation:tool:selftest": "tsx scripts/rotate-integration-tokens.ts --selftest",
    "deploy:evidence:providers": "node scripts/write-provider-quality-evidence.mjs",
    "deploy:evidence:providers:selftest": "node scripts/write-provider-quality-evidence.mjs --selftest",
    "deploy:evidence:api": "node scripts/write-api-connectivity-evidence.mjs",
    "deploy:evidence:api:selftest": "node scripts/write-api-connectivity-evidence.mjs --selftest",
    "deploy:evidence:pii": "node scripts/write-pii-ciphertext-evidence.mjs",
    "deploy:evidence:pii:selftest": "node scripts/write-pii-ciphertext-evidence.mjs --selftest",
    "deploy:evidence:webhooks": "node scripts/write-webhook-secret-ciphertext-evidence.mjs",
    "deploy:evidence:webhooks:selftest": "node scripts/write-webhook-secret-ciphertext-evidence.mjs --selftest",
    "deploy:evidence:mcp": "node scripts/write-mcp-connectivity-evidence.mjs",
    "deploy:evidence:mcp:selftest": "node scripts/write-mcp-connectivity-evidence.mjs --selftest",
    "deploy:evidence:load": "cross-env BIDSTACK_LOAD_EVIDENCE_STRICT=true K6_DURATION_PROFILE=certification node scripts/run-k6-load-test.mjs",
    "deploy:evidence:tools": "cross-env BIDSTACK_TOOL_READINESS_EXECUTE_IMAGE_PROBES=true node scripts/write-release-tool-readiness.mjs",
    "deploy:evidence:tools:selftest": "node scripts/write-release-tool-readiness.mjs --selftest",
    "deploy:evidence:semgrep": "node scripts/run-semgrep-sast.mjs",
    "deploy:evidence:container": "cross-env BIDSTACK_CONTAINER_SCAN_STRICT=true node scripts/run-container-vulnerability-scan.mjs",
    "deploy:evidence:a11y": "node scripts/write-a11y-evidence.mjs --run-playwright",
    "deploy:evidence:a11y:write": "node scripts/write-a11y-evidence.mjs",
    "deploy:evidence:a11y:selftest": "node scripts/write-a11y-evidence.mjs --selftest",
    "deploy:evidence:browser": "node scripts/write-browser-regression-evidence.mjs --run-playwright",
    "deploy:evidence:browser:write": "node scripts/write-browser-regression-evidence.mjs",
    "deploy:evidence:browser:selftest": "node scripts/write-browser-regression-evidence.mjs --selftest",
    "deploy:evidence:secrets": "node scripts/write-secret-scan-evidence.mjs",
    "deploy:evidence:secrets:selftest": "node scripts/write-secret-scan-evidence.mjs --selftest",
    "deploy:evidence:sentry": "node scripts/write-sentry-smoke-evidence.mjs",
    "deploy:evidence:sentry:trigger": "node scripts/write-sentry-smoke-evidence.mjs --trigger-smoke",
    "deploy:evidence:sentry:selftest": "node scripts/write-sentry-smoke-evidence.mjs --selftest",
    "db:analyze-queries": "tsx packages/db/scripts/analyze-slow-queries.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "db:generate": "pnpm --filter @bidstack/db generate",
    "db:migrate": "pnpm --filter @bidstack/db migrate",
    "db:migrate:deploy": "node scripts/run-safe-migrate-deploy.mjs",
    "db:migrate:deploy:selftest": "node scripts/run-safe-migrate-deploy.mjs --selftest",
    "db:seed": "pnpm --filter @bidstack/db seed",
    "db:seed:demo": "pnpm --filter @bidstack/db seed:demo",
    "db:seed:prod": "pnpm --filter @bidstack/db seed:prod",
    "db:purge:demo": "pnpm --filter @bidstack/db purge:demo",
    "db:reset": "pnpm --filter @bidstack/db reset",
    "db:studio": "pnpm --filter @bidstack/db studio",
    "webhooks:encrypt-secrets": "tsx scripts/encrypt-webhook-secrets.ts --dry-run",
    "webhooks:encrypt-secrets:selftest": "tsx scripts/encrypt-webhook-secrets.ts --selftest",
    "clean": "pnpm -r exec rimraf dist build .turbo .vite",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@bidstack/db": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^4.1.8",
    "bullmq": "^5.34.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "ioredis": "^5.4.2",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@sentry/node-cpu-profiler",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ],
    "overrides": {
      "happy-dom": ">=20.8.9",
      "esbuild": ">=0.28.1",
      "@grpc/grpc-js": ">=1.14.4",
      "d3-color@<3.1.0": ">=3.1.0",
      "js-cookie": "3.0.7",
      "tar": "7.5.11",
      "@xmldom/xmldom": "0.8.13",
      "tmp": "0.2.7",
      "form-data": "4.0.6",
      "vite": "6.4.3",
      "protobufjs": "7.6.4",
      "hono": "4.12.25",
      "js-yaml": "4.2.0",
      "@babel/core": "7.29.7",
      "@opentelemetry/core": "2.8.0",
      "ws": "8.21.0"
    }
  }
}
