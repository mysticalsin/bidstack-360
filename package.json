{
  "name": "bidstack-360",
  "version": "0.1.0",
  "private": true,
  "description": "BidStack 360° — Mantu's bid & presales CRM. Standalone build with future Twenty overlay path preserved under packages/twenty-bidstack.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:web": "pnpm --filter @bidstack/web dev",
    "dev:api": "pnpm --filter @bidstack/api dev",
    "dev:worker": "pnpm --filter @bidstack/worker dev",
    "dev:mcp": "pnpm --filter @bidstack/mcp-server dev",
    "build": "pnpm -r --stream build",
    "lint": "pnpm -r --stream lint",
    "typecheck": "pnpm db:generate && pnpm --filter @bidstack/shared build && pnpm --filter @bidstack/dust-client build && pnpm -r --stream typecheck",
    "test": "pnpm --filter @bidstack/shared build && pnpm --filter @bidstack/dust-client build && pnpm -r --stream test",
    "test:watch": "pnpm -r --parallel --stream test:watch",
    "e2e": "pnpm --filter @bidstack/web e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "db:generate": "pnpm --filter @bidstack/db generate",
    "db:migrate": "pnpm --filter @bidstack/db migrate",
    "db:seed": "pnpm --filter @bidstack/db seed",
    "db:reset": "pnpm --filter @bidstack/db reset",
    "db:studio": "pnpm --filter @bidstack/db studio",
    "clean": "pnpm -r exec rimraf dist build .turbo .vite",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ],
    "overrides": {
      "happy-dom": ">=20.8.9"
    }
  }
}
