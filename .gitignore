# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
.turbo/
.vite/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
*.pem
*.key

# IDE
.vscode/
.idea/
.cursor/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test artifacts
coverage/
.nyc_output/
playwright-report/
test-results/
load-test-report/
deploy-evidence/
trace_extracted/
*.err

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Claude local state
CLAUDE.local.md
.claude/local/
.claude/cache/
.claude/settings.local.json

# Prisma generated client (regenerate on install)
packages/db/generated/

# Local file storage (apps/api writes uploaded attachments here when
# STORAGE_DRIVER=local). Production runs use S3 — these bytes should
# never enter git, full stop.
apps/api/.uploads/
apps/api/.uploads/**
.uploads/

# Vercel
.vercel/

# Sentry source maps
.sentryclirc

# Conductor harness state (auto-generated locally)
.conductor/

# Large source bundles (kept out of repo; the unpacked tree under handoff/ is canonical)
*.zip
.tmp/

# Mobile — EAS credentials and secrets (never commit)
apps/mobile/google-service-account.json
apps/mobile/google-services.json
apps/mobile/*.p8
apps/mobile/*.p12
apps/mobile/*.mobileprovision

# Claude Code local artifacts (worktrees, scheduler lock, slash-command cache)
.claude/worktrees/
.claude/commands/
.claude/scheduled_tasks.lock

# Tool/agent scratch outputs (screenshots, page snapshots, debug outputs)
.forge/
.playwright-mcp/
.tmp-screens/
.swarm_state/
.claire/
.clone/
.codex/
.local/
scratch/
scratch_skills/
apps/web/scratch/
apps/api/debug-out.txt
.planning/review-out.txt

# Generated i18n sweep scratch files. Keep the canonical coverage script, but
# do not let temporary batch drivers/results enter release source evidence.
apps/web/scripts/_i18n_*

# Root-level screenshot dumps (from Playwright QA passes)
*.png
*.mjs
!scripts/*.mjs

# Web app screenshot blobs (committed by QA runs, not source)
apps/web/*.png
apps/web/e2e/responsive/*-snapshots/

# Scratch / exploratory scripts at repo root
screenshot-*.cjs
scratch-*.js
.vercel

# Machine-specific tool shims (hardcoded local paths)
walteur-kit/bin/

# Prisma schema scratch copies (use git history instead)
packages/db/prisma/schema.prisma.backup
packages/db/prisma/schema.prisma.pulled

# QA swarm artifacts (session-generated)
.qa-artifacts/

# Brand raster assets under public/ are source, not QA screenshots
!apps/web/public/*.png
!apps/chrome-extension/src/icons/*.png
