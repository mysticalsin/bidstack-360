# BidStack release evidence inputs.
#
# Copy these values into your CI secret store or a local ignored file such as
# deploy-evidence/release-evidence.env. Never commit filled secrets.
# The bundle still requires a clean, reviewed Git worktree before deploy.
# Values left as .example domains, <placeholders>, sample tickets, or
# example.com approver/reviewer emails intentionally fail preflight.

# Target release scope.
BIDSTACK_DEPLOY_ENV=staging
PUBLIC_BASE_URL=https://staging.bidstack.example
API_BASE_URL=https://staging-api.bidstack.example

# Shared short-lived release API token for authenticated evidence calls.
# Must be scoped to the release-evidence service account.
API_TOKEN=<short-lived-release-bearer-token>

# Load certification.
K6_DOCKER_API_BASE_URL=https://staging-api.bidstack.example
BIDSTACK_LOAD_ROLE=release-certification
SKIP_AUTHENTICATED_ROUTES=false

# Operational readiness. Fill the JSON file from
# docs/templates/operational-readiness.example.json after platform/ops approve
# the Azure plan, migration path, backup/restore, rollback, monitoring, and
# on-call evidence for this release.
BIDSTACK_OPS_READINESS_FILE=deploy-evidence/operational-readiness.json

# Provider quality evidence for Technical Stack Overview.
BIDSTACK_PROVIDER_QUALITY_TARGET=https://staging-api.bidstack.example
BIDSTACK_PROVIDER_QUALITY_API_TOKEN=<short-lived-release-bearer-token>
BIDSTACK_PROVIDER_QUALITY_COMPANY_KEY=<company-key-with-live-provider-data>
BIDSTACK_PROVIDER_QUALITY_REQUIRED=apollo,seamless,tech_intel
BIDSTACK_PROVIDER_QUALITY_TECH_INTEL_SOURCES=BuiltWith MCP,Wappalyzer MCP
BIDSTACK_DEPLOY_REQUIRED_TECH_INTEL_SOURCES=BuiltWith MCP,Wappalyzer MCP
BIDSTACK_PROVIDER_QUALITY_ALLOW_APOLLO_QUEUED=true

# Live provider credentials used by the API/worker behind provider evidence.
# Prefer MCP lanes. Apollo REST is fallback only and can consume credits.
APOLLO_MCP_URL=https://mcp.apollo.io/mcp
APOLLO_MCP_BEARER_TOKEN=<apollo-mcp-bearer-token>
APOLLO_MCP_ENABLE_CREDIT_TOOLS=false
APOLLO_API_KEY=

SEAMLESS_MCP_URL=<seamless-mcp-url>
SEAMLESS_MCP_BEARER_TOKEN=<seamless-mcp-bearer-token>
SEAMLESS_API_KEY=

TECH_STACK_MCP_URL=<builtwith-or-wappalyzer-mcp-url>
TECH_STACK_MCP_BEARER_TOKEN=<tech-intel-mcp-bearer-token>
TECH_STACK_MCP_TOOL=detect_company_technologies
TECH_STACK_MCP_LABEL=Tech Intel MCP
TECH_STACK_MCP_SOURCE_IDS=BUILTWITH,WAPPALYZER
TECH_STACK_MCP_BUILTWITH_URL=<builtwith-mcp-url>
TECH_STACK_MCP_BUILTWITH_BEARER_TOKEN=<builtwith-mcp-bearer-token>
TECH_STACK_MCP_BUILTWITH_TOOL=detect_company_technologies
TECH_STACK_MCP_BUILTWITH_LABEL=BuiltWith MCP
TECH_STACK_MCP_WAPPALYZER_URL=<wappalyzer-mcp-url>
TECH_STACK_MCP_WAPPALYZER_BEARER_TOKEN=<wappalyzer-mcp-bearer-token>
TECH_STACK_MCP_WAPPALYZER_TOOL=detect_company_technologies
TECH_STACK_MCP_WAPPALYZER_LABEL=Wappalyzer MCP

# Secret-history disposition. Fill the JSON file from
# docs/templates/secret-history-disposition.example.json after the security
# owner verifies historical findings were rotated/revoked or are clean.
BIDSTACK_SECRET_DISPOSITION_FILE=deploy-evidence/secret-history-disposition.json

# Sentry release smoke evidence.
BIDSTACK_SENTRY_API_BASE_URL=https://staging-api.bidstack.example
BIDSTACK_SENTRY_SMOKE_TOKEN=<release-smoke-token-at-least-24-chars>
BIDSTACK_SENTRY_RELEASE=bidstack@0.1.0+<git-sha>
SENTRY_ENVIRONMENT=staging
BIDSTACK_SENTRY_ORG=<sentry-org-slug>
BIDSTACK_SENTRY_API_PROJECT=bidstack-api
BIDSTACK_SENTRY_WORKER_PROJECT=bidstack-worker
BIDSTACK_SENTRY_DSN_CONFIGURED=true

# Browser regression evidence. Must use Clerk-backed test users, not stub auth.
BIDSTACK_BROWSER_REGRESSION_TARGET=https://staging.bidstack.example
E2E_API_URL=https://staging-api.bidstack.example
BIDSTACK_BROWSER_AUTH_MODE=clerk
BIDSTACK_BROWSER_PRODUCTION_BUILD=true
BIDSTACK_BROWSER_PROJECTS=chromium-desktop,firefox-desktop,webkit-desktop
BIDSTACK_BROWSER_SPECS=e2e/flows/rbac.spec.ts
