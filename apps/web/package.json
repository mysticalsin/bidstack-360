{
  "name": "@bidstack/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env VITE_AUTH_MODE=stub vite",
    "build": "pnpm --filter @bidstack/shared build && cross-env NODE_ENV=production BIDSTACK_ALLOW_STUB_AUTH=true VITE_AUTH_MODE=stub tsc -b && cross-env NODE_ENV=production BIDSTACK_ALLOW_STUB_AUTH=true VITE_AUTH_MODE=stub vite build",
    "build:prod": "pnpm --filter @bidstack/shared build && cross-env NODE_ENV=production VITE_AUTH_MODE=clerk tsc -b && cross-env NODE_ENV=production VITE_AUTH_MODE=clerk vite build",
    "build:demo": "pnpm --filter @bidstack/shared build && cross-env NODE_ENV=production VITE_AUTH_MODE=demo tsc -b && cross-env NODE_ENV=production VITE_AUTH_MODE=demo vite build",
    "analyze": "tsc -b && vite build --mode analyze",
    "preview": "cross-env BIDSTACK_ALLOW_STUB_AUTH=true VITE_AUTH_MODE=stub vite preview --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@bidstack/shared": "workspace:*",
    "@clerk/clerk-react": "^5.61.9",
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/browser": "^9.0.0",
    "@sentry/react": "^9.0.0",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-collaboration": "^3.29.2",
    "@tiptap/extension-collaboration-cursor": "^3.0.0",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "i18next": "^23.16.4",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.5",
    "js-base64": "^3.9.2",
    "lib0": "^0.2.117",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "nuqs": "^2.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "react-router-dom": "^6.30.4",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.31",
    "zod": "^3.24.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.12.1",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/d3-scale": "^4.0.9",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.11.1",
    "lighthouse": "^13.4.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.10"
  }
}
