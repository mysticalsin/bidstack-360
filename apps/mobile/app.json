{
  "expo": {
    "name": "BidStack 360°",
    "slug": "bidstack-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bidstack",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F172A",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.bidstack.crm",
      "buildNumber": "1",
      "usesAppleSignIn": false,
      "infoPlist": {
        "NSCameraUsageDescription": "BidStack uses the camera to photograph and attach documents to deals and contacts.",
        "NSPhotoLibraryUsageDescription": "BidStack accesses your photo library to attach images to deals, proposals, and contacts.",
        "NSFaceIDUsageDescription": "BidStack uses Face ID to secure access to your CRM data.",
        "NSContactsUsageDescription": "BidStack reads your contacts to auto-populate and enrich CRM records with AI assistance.",
        "NSCalendarsUsageDescription": "BidStack syncs meetings and follow-ups with your calendar.",
        "NSMicrophoneUsageDescription": "BidStack uses the microphone for voice memos attached to activities.",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "io.bidstack.crm",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "ACCESS_NETWORK_STATE",
        "READ_CONTACTS",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "BidStack uses the camera to photograph and attach documents."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "imageResizeMode": "contain"
        }
      ]
    ],
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/bidstack-mobile-placeholder"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
